# Copy this file to ".env" (same folder as docker-compose.yml) and set a real random
# secret before exposing this app to the internet. Generate one with e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
DAFTAR_JWT_SECRET=replace-this-with-a-long-random-string
DAFTAR_JWT_EXPIRES_DAYS=7
